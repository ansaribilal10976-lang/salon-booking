# Copy this file to .env.local and fill in your Supabase project values.
# Find these in your Supabase project's Connect dialog or Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEXT_PUBLIC_* values are exposed to the browser.
# Use a complete public anon JWT or sb_publishable_... key here.
# Never use a service_role key or database password.
# Keep real credentials in .env.local (gitignored), not in this example.

# Optional: protect /api/health with an exact Authorization: Bearer <CRON_SECRET>.
# Vercel Cron sends this header when CRON_SECRET is set in the deployment.
# Leave unset/empty for public health checks; keep real secrets out of this file.
CRON_SECRET=
